{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gantt.schema.json",
  "title": "The /todo chart",
  "description": "Groups of rows. A row's bar length is relative complexity, never time, on one axis shared by every group. plan.mjs writes site/src/lib/todo.json from it.",
  "type": "object",
  "required": ["updated", "version", "examples", "groups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "$ref": "defs.schema.json#/$defs/date" },
    "version": { "$ref": "defs.schema.json#/$defs/version" },
    "examples": { "$ref": "#/$defs/examples" },
    "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/group" } }
  },
  "$defs": {
    "examples": {
      "type": "object",
      "required": ["running", "total", "note"],
      "additionalProperties": false,
      "properties": {
        "running": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "title", "subtitle", "open", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "title": { "$ref": "defs.schema.json#/$defs/text" },
        "subtitle": { "type": "string" },
        "open": { "type": "boolean", "description": "Whether the group starts unfolded. The axis fits the open groups." },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "name", "start", "size", "state", "note", "issues"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/text" },
        "start": { "type": "number", "minimum": 0 },
        "size": { "type": "number", "minimum": 0.5 },
        "state": { "$ref": "defs.schema.json#/$defs/state" },
        "note": { "type": "string" },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/issue" },
          "description": "The issues of the row's work. Empty for history with no TODO item."
        }
      }
    }
  }
}
