  "authority": "D310 contained physical selection; D311 source/status/process boundary; D313 complete human representation",
  "status": "Test-only observation/archive/human-rendering substrate; merged config/CLI association, complete source selector, cold association and replay authority remain absent",
  "new_rawr_modules": [
    "membership.rs",
    "host.rs",
    "observed.rs",
    "stored.rs",
    "tests.rs",
    "human.rs",
    "human/tests.rs",
