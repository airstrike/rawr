  ],
  "sources": [
    {
      "project": "cargo",
      "commit": "59800466c5c41c444d264b1010b4d57e85a7117f",
      "url": "https://raw.githubusercontent.com/rust-lang/cargo/59800466c5c41c444d264b1010b4d57e85a7117f/src/cargo/ops/cargo_package/mod.rs",
      "path": "src/cargo/ops/cargo_package/mod.rs",
      "sha256": "64e6ce16c60941a190a086f77b8df5e79b0bd6e437aa23048464194380e2176b",
      "bytes": 46185,
      "local": [
        "archive.rs",
        "human.rs"
      ],
      "lines": "303-312,497-687,1091-1117",
      "license": "MIT OR Apache-2.0",
      "changes": "Ordered archive projection extraction: replace ambient stat with closed host; retain Copy origins and Generate kinds/presence while omitting exactly classified generated values; preserve physical original-manifest origin and metadata collision precedence over all rows; precharge ownership; replace HashMap/flatten/sort with admitted vector and bounded in-place heapsort; typed errors replace allocating diagnostics. Human comparison feeds each complete rel_str followed by LF through one persistent pinned StripBytes state when configured, using bounded counting and borrowed comparison without line decoding or output-only source authority. Mode derives from caller-supplied complete TermConfig/CLI result and the closed sealed-command environment; complete config association remains an explicit missing seam."
    },
    {
