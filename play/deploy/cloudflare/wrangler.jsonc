// rawr-play on Cloudflare Containers, serving all of rawr.airstrike.fyi.
// Build and push the image with ./push-image.sh (it rewrites "image" below),
// then `npx wrangler deploy` (it runs build.mjs first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawr-play",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "PlayBot",
      // A registry address, not a Dockerfile, so deploy never calls docker.
      "image": "registry.cloudflare.com/fce80b8101fbb2f85548560babc6c7bc/rawr-play:bdf44e242d63",
      // lite: 1/16 vCPU, 256 MiB. A render peaks well under that (see
      // play/README.md); "basic" (1/4 vCPU, 1 GiB) renders faster.
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PLAY_BOT", "class_name": "PlayBot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayBot"] }],
  // /todo's private tabs, rendered by plan/private.mjs from the local
  // .Codex/ documents (never in this repository). src/todo.ts serves them
  // behind the TODO_PASSWORD secret.
  "kv_namespaces": [{ "binding": "TODO_PRIVATE", "id": "c587b986e0fd47c8a8e25a24d836048e" }],
  // Restart the bot within five minutes if it ever stops.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PLAY_WORKERS": "1",
    "PLAY_MEMORY_MB": "256",
    // Whole render, killed after it: an idle animation's 60 s, plus the
    // start and the GIF's encoding.
    "PLAY_TIMEOUT_MS": "80000",
    // Script time per render; 2 s was too tight for large canvases on lite.
    "PLAY_TIME_MS": "5000",
    // An animation's time per render, once its view changes. One render at
    // a time gets it, and each user (or playground IP) gets 90 s of it in
    // any 10 minutes; others get PLAY_TIME_MS.
    "PLAY_ANIMATION_TIME_MS": "15000",
    // An animation's time when no other render is queued or running. Once
    // it is past PLAY_ANIMATION_TIME_MS, a newcomer cuts it at its next frame.
    "PLAY_IDLE_ANIMATION_TIME_MS": "60000",
    "PLAY_ANIMATION_ALLOWANCE_S": "90",
    "PLAY_ANIMATION_WINDOW_S": "600",
    // The image's commit (push-image.sh writes it): a running bot started
    // from another image is restarted by the next cron or /health.
    // Turnstile's public site key for /play (the secret is TURNSTILE_SECRET).
    "TURNSTILE_SITEKEY": "0x4AAAAAAFfQTZDPbRvs2kSG",
    "PLAY_VERSION": "bdf44e242d63"
  },
  // /play's examples (play/tests/fixtures/**/*.rs), as text.
  "rules": [{ "type": "Text", "globs": ["**/*.rs"], "fallthrough": false }],
  // dist/ is site/dist (the Astro build: the landing page, the docs, /play's page) and public/
  // (/bot/invite, the redirect with its link preview; /og/invite.png, which
  // rawr-play renders from og/card.rs), merged by build.mjs. It also writes
  // src/runnable.gen.ts, the hashes of the sources /play/run accepts.
  "build": { "command": "node build.mjs" },
  // The Worker runs first so it can redirect the old host; for the new host
  // it hands every path but /play and /bot to the assets.
  "assets": { "directory": "dist", "binding": "ASSETS", "html_handling": "drop-trailing-slash", "run_worker_first": true },
  "routes": [
    { "pattern": "rawr.airstrike.fyi", "custom_domain": true },
    // The old host: every request gets a redirect to rawr.airstrike.fyi.
    { "pattern": "rawr-bot.airstrike.fyi", "custom_domain": true }
  ]
  // DISCORD_TOKEN is a secret: `npx wrangler secret put DISCORD_TOKEN`.
  // TODO_PASSWORD is a secret, from the untracked .asdrubal at the
  // repository's root: `tr -d '\n' < ../../../.asdrubal | npx wrangler secret put TODO_PASSWORD`.
}
