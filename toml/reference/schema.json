{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One line of rawr-toml-reference output.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "local_test", "purpose", "source", "expected_acceptance", "accepted", "document", "errors", "raw"],
  "properties": {
    "schema": { "const": "rawr-toml-reference-v1" },
    "id": { "type": "string" },
    "local_test": { "type": "string" },
    "purpose": { "type": "string" },
    "source": { "type": "string" },
    "expected_acceptance": { "type": "boolean" },
    "accepted": { "type": "boolean" },
    "document": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "errors"],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/raw_error" } }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "array",
      "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    },
    "optional_span": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent", "index", "key", "key_span", "kind", "span"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "parent": { "type": ["integer", "null"], "minimum": 0 },
        "index": { "type": "integer", "minimum": 0 },
        "key": { "type": ["string", "null"] },
        "key_span": { "$ref": "#/$defs/optional_span" },
        "kind": { "enum": ["table", "array", "string", "integer", "float", "boolean", "datetime"] },
        "span": { "$ref": "#/$defs/span" },
        "text": { "type": "string" },
        "radix": { "enum": [2, 8, 10, 16] },
        "value": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["string", "integer", "float", "datetime"] } } }, "then": { "required": ["text"] } },
        { "if": { "properties": { "kind": { "const": "integer" } } }, "then": { "required": ["radix"] } },
        { "if": { "properties": { "kind": { "const": "boolean" } } }, "then": { "required": ["value"] } }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "span"],
      "properties": {
        "message": { "type": "string" },
        "span": { "$ref": "#/$defs/optional_span" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "encoding", "span"],
      "properties": {
        "kind": { "type": "string" },
        "encoding": { "type": ["string", "null"] },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "raw_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "context", "unexpected", "expected"],
      "properties": {
        "description": { "type": "string" },
        "context": { "$ref": "#/$defs/optional_span" },
        "unexpected": { "$ref": "#/$defs/optional_span" },
        "expected": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": { "enum": ["literal", "description"] },
              "value": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
