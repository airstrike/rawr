#!/bin/sh
# D507: the pre-commit checks over everything being pushed (Clippy over the
# whole workspace), and no pushed commit message mentions Claude.
zero=0000000000000000000000000000000000000000
CHECK_FILES=""
pushing=""
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    # Commits not on any remote yet.
    if git log --format='%s%n%b' "$local_sha" --not --remotes | grep -qi "Claude"; then
        echo "ERROR: a commit message being pushed mentions 'Claude':"
        git log --format='  %h %s' "$local_sha" --not --remotes --grep='Claude' -i
        exit 1
    fi
    added=$(git log --format= --name-only --diff-filter=ACR "$local_sha" --not --remotes)
    CHECK_FILES=$(printf '%s\n%s' "$CHECK_FILES" "$added")
    changed=$(printf '%s\n%s' "$changed" "$(git log --format= --name-only "$local_sha" --not --remotes)")
    pushing=1
done
[ -n "$pushing" ] || exit 0

. "$(git rev-parse --show-toplevel)/.githooks/checks.sh"
check_layout || exit 1
check_audit || exit 1
check_rust --workspace || exit 1
# A push that changes the site or its Worker runs the tests site.yml runs
# before it deploys, so a failing one stops here rather than the deploy.
if printf '%s\n' "$changed" | grep -qE '^(site|play/deploy)/'; then
    root=$(git rev-parse --show-toplevel)
    # Git sets GIT_DIR and friends for a hook; the deploy script's tests run
    # git in their own fixture repositories, which those would redirect.
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH
    echo "Running the site's and the Worker's tests..."
    log="$root/target/logs/pre-push-site.log"; mkdir -p "$root/target/logs"
    npm --prefix "$root/site" test >"$log" 2>&1 || { tail -30 "$log"; echo "ERROR: npm --prefix site test failed (log: $log)"; exit 1; }
    # The Worker's build and its page tests (links, the injected data). The
    # deploy script's own tests stub the shell's tools on PATH and run in CI.
    (cd "$root/play/deploy/cloudflare" && node build.mjs && node --test test/play.test.ts) >"$log" 2>&1 \
        || { tail -30 "$log"; echo "ERROR: the Worker's tests failed (log: $log)"; exit 1; }
fi
exit 0
