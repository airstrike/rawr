---
// Every page's <head>: the theme before the first paint, the title,
// description and link preview, and the font, which the page waits for
// (FONT_GATE). Then the site bar and the page.
import Header from "../components/Header.astro";
import { SITE } from "../lib/docs.ts";
import { CHROME, FONT_GATE, THEME_INIT } from "../lib/theme-init.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The page's path, for its canonical URL. */
  path: string;
  current?: "docs" | "play";
  /** The page has the docs' tree (#docs-nav), which the bar opens as a drawer on narrow screens. */
  drawer?: boolean;
  /** The link preview's title and description, when they differ from the page's. */
  og?: { title?: string; description?: string; image?: string; alt?: string; twitter?: boolean };
  icon?: string;
  bodyClass?: string;
}
const { title, description, path, current, drawer = false, og = {}, icon = "/favicon.svg", bodyClass } = Astro.props;
const url = `${SITE}${path}`;
const image = og.image ?? `${SITE}/og/card.png`;
const alt = og.alt ?? "rawr is rust augmented with rust: a Rust interpreter for your dev builds. The same src/main.rs is compiled by Cargo and interpreted by rawr, and both print total: 27.";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content={CHROME.light} data-follow>
<script is:inline set:html={THEME_INIT} />
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={og.title ?? title}>
<meta property="og:description" content={og.description ?? description}>
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={alt}>
<meta name="twitter:card" content="summary_large_image">
{og.twitter && <meta name="twitter:title" content={og.title ?? title}>}
{og.twitter && <meta name="twitter:description" content={og.description ?? description}>}
{og.twitter && <meta name="twitter:image" content={image}>}
{og.twitter && <meta name="twitter:image:alt" content={alt}>}
<link rel="canonical" href={url}>
<link rel="icon" href={icon} type="image/svg+xml">
<link rel="preconnect" href="https://abitaro-sans.pages.dev" crossorigin>
<link rel="stylesheet" href="https://abitaro-sans.pages.dev/abitaro-sans.css?v=0.300">
<script is:inline set:html={FONT_GATE} />
<slot name="head" />
</head>
<body class={bodyClass}>
<div class="bar-top" aria-hidden="true"></div>
<Header current={current} drawer={drawer} />
<slot />
<script is:inline>
// The bar takes its scrolled shade once the sentinel above it leaves the view.
(() => {
  const top = document.querySelector(".bar-top"), bar = document.querySelector(".bar");
  if (!top || !bar || !("IntersectionObserver" in window)) return;
  new IntersectionObserver(([entry]) => bar.classList.toggle("scrolled", !entry.isIntersecting)).observe(top);
})();
</script>
</body>
</html>
