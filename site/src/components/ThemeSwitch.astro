---
// The theme switch, in the site bar and on /todo: a sun in the dark theme, a
// moon in the light one. It sets <html data-theme> and remembers the choice
// (theme.ts); until the visitor picks, the page follows the system.
---
<button type="button" class="theme" aria-label="Switch theme" data-theme-switch>
  <svg class="sun" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="3" fill="currentColor"/><path d="M8 0.5v2.2M8 13.3v2.2M0.5 8h2.2M13.3 8h2.2M2.7 2.7l1.6 1.6M11.7 11.7l1.6 1.6M2.7 13.3l1.6-1.6M11.7 4.3l1.6-1.6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
  <svg class="moon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M13.6 10.2A6 6 0 0 1 5.8 2.4a6 6 0 1 0 7.8 7.8Z" fill="currentColor"/></svg>
</button>
<script>
  import { followSystem, setupSwitch } from "../lib/theme.ts";
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-switch]")) setupSwitch(button);
  followSystem();
</script>
<style>
  /* A 26px box with a 44px tap target around it. */
  .theme {
    position: relative;
    display: inline-grid; place-items: center; vertical-align: middle;
    width: 26px; height: 26px; padding: 0; margin: 0;
    border: 1px solid var(--grid); border-radius: 0;
    background: transparent; color: var(--quiet); cursor: pointer;
  }
  .theme:hover { color: var(--ink); border-color: var(--ink); background: transparent; }
  .theme:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  .theme::before { content: ""; position: absolute; inset: -10px; }
  .theme svg { width: 14px; height: 14px; display: block; }
  :global([data-theme="dark"]) .theme .moon, :global([data-theme="light"]) .theme .sun { display: none; }
</style>
