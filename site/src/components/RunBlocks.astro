---
// The Run buttons' stylesheet and script, on a page with runnable snippets.
// The inline script swaps each snippet's highlighted copy in before the first
// paint; the HTML itself keeps the plain text /play/run's allow-list reads.
import "../styles/run.css";
---
<script is:inline>
for (const t of document.querySelectorAll("code[data-run] + template[data-hl]")) t.previousElementSibling.innerHTML = t.innerHTML;
</script>
<script>
  import { setup } from "../scripts/run.ts";
  import { WEB_MODULE } from "../play/session.ts";
  setup({
    document,
    window,
    fetch: fetch.bind(window),
    // rawr-web, as the playground loads it.
    web: async () => {
      const m = await import(/* @vite-ignore */ WEB_MODULE);
      await m.default();
      return m;
    },
  });
</script>
