---
// The Run buttons' stylesheet and script, on a page with runnable snippets.
// The inline script swaps each snippet's highlighted copy in before the first
// paint; the HTML itself keeps the plain text the Run button reads.
// `warm` warms the page's snippets once it has loaded (scripts/run.ts).
import "../styles/run.css";
const { warm = false } = Astro.props;
---
<script is:inline>
for (const t of document.querySelectorAll("code[data-run] + template[data-hl]")) t.previousElementSibling.innerHTML = t.innerHTML;
</script>
{warm && <template data-run-warm></template>}
<script>
  import { setup } from "../scripts/run.ts";
  import { universe } from "../scripts/universe.ts";
  import { WEB_MODULE } from "../play/session.ts";
  let copies = 0;
  setup({
    document,
    window,
    warm: document.querySelector("template[data-run-warm]") !== null,
    // The browser's universe, for blocks that use crates.
    universe: universe({
      document,
      fetch: fetch.bind(window),
      compile: (response) => WebAssembly.compileStreaming(response),
    }),
    // rawr-web, as the playground loads it. A module is imported once per
    // address, so a copy after the first has its own query: its own
    // instance, from the same cached files.
    web: async () => {
      const m = await import(/* @vite-ignore */ WEB_MODULE + (copies++ ? "?" + copies : ""));
      await m.default();
      return m;
    },
  });
</script>
